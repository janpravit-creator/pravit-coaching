# Vorlage für die End-to-End-Tests.
#
# Kopieren nach .env.e2e und ausfüllen. .env.e2e ist in .gitignore gesperrt
# und darf niemals eingecheckt werden.
#
# Das Konto sollte ein Wegwerf-Konto sein: Der Test legt darin einen echten
# Check-in und einen echten Logbuch-Eintrag an.
E2E_EMAIL=
E2E_PASSWORT=

# Nur für den Coach-Test: Setzt man diese Adresse auf das Testkonto, sieht
# derselbe Zugang den Coach-Arbeitsplatz. Im Auslieferungs-Build bleibt sie leer.
# VITE_COACH_EMAIL=
