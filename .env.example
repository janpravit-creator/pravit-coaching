# PRAVIT Coaching – Umgebungsvariablen
#
# Diese Datei ist nur eine Vorlage und wird mit eingecheckt. Die echten Werte
# gehören in die Netlify-Oberfläche (Site settings → Environment variables)
# bzw. in eine lokale `.env`, die von `.gitignore` erfasst ist.

# ── End-to-End-Tests ───────────────────────────────────────────────────────
#
# Kopieren nach .env.e2e und ausfüllen. .env.e2e ist in .gitignore gesperrt
# und darf niemals eingecheckt werden.
#
# Das Konto sollte ein Wegwerf-Konto sein: Der Test legt darin einen echten
# Check-in und einen echten Logbuch-Eintrag an.
E2E_EMAIL=
E2E_PASSWORT=

# Nur für den Coach-Test: Setzt man diese Adresse auf das Testkonto, sieht
# derselbe Zugang den Coach-Arbeitsplatz. Im Auslieferungs-Build bleibt sie leer.
VITE_COACH_EMAIL=

# ── Frontend (werden ins Bündel gebacken, also NICHT geheim) ────────────────

# Eigener USDA-Schlüssel für die Lebensmittelsuche. Ohne Angabe wird der
# mitgelieferte verwendet.
VITE_USDA_API_KEY=

# Geschäftsangaben für Rechnung und Impressum. Solange sie leer bleiben,
# stehen in der App Platzhalter, und die Rechnung warnt vor dem Druck.
VITE_FIRMA_NAME=Jan Pravit Jungmann
VITE_FIRMA_ZUSATZ=PRAVIT Coaching
VITE_FIRMA_STRASSE=
VITE_FIRMA_PLZ_ORT=
VITE_FIRMA_EMAIL=jan.pravit@gmx.de
VITE_FIRMA_TELEFON=
VITE_FIRMA_STEUERNUMMER=
VITE_FIRMA_IBAN=
VITE_FIRMA_KONTOINHABER=Jan Pravit Jungmann
VITE_FIRMA_ZAHLUNGSZIEL=14

# ── Netlify-Funktionen (echte Geheimnisse, NIE ins Repository) ──────────────

# Stripe-Schlüssel. Zum Ausprobieren die Testschlüssel (sk_test_…) nehmen –
# damit lässt sich der ganze Ablauf mit der Testkarte 4242 4242 4242 4242
# durchspielen, ohne dass Geld fließt.
STRIPE_GEHEIM=
STRIPE_WEBHOOK_GEHEIM=

# Die Abo-Preise, die im Stripe-Dashboard angelegt wurden (Produkt → Preis →
# „price_…"). Ein Paket ohne hinterlegten Preis ist schlicht nicht buchbar.
STRIPE_PREIS_TRAINING=
STRIPE_PREIS_ERNAEHRUNG=
STRIPE_PREIS_KOMPLETT=
STRIPE_PREIS_PREMIUM=

# Adresse der Seite, für den Rücksprung nach der Zahlung.
SEITEN_URL=

# Firebase-Dienstkonto als eine JSON-Zeile. Firebase-Konsole →
# Projekteinstellungen → Dienstkonten → „Neuen privaten Schlüssel erzeugen".
# Achtung: Das ist Vollzugriff auf die Datenbank.
FIREBASE_DIENSTKONTO=
